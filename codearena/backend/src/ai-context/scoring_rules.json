        {
          "id": "example",
          "label": "Gives a valid Has-A example",
          "marks": 1,
          "required": false,
          "variants": [
            "company has employees",
            "company has employee",
            "car has engine",
            "student has address",
            "library has books",
            "order has items",
            "person has address"
          ]
        },
        {
          "id": "object_vague",
