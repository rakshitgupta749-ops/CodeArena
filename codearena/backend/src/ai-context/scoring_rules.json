      "match": {
        "any": [
          "has-a",
          "has a relationship",
          "has a relation",
          "composition",
          "aggregation"
        ]
      },
      "intent": "understand Has-A relationship in Java",
      "max_score": 5,
      "concepts": [
        {
          "id": "composition_or_aggregation",
          "label": "Names composition or aggregation",
          "marks": 2,
          "required": true,
          "variants": [
            "composition",
            "aggregation",
            "has a relationship",
            "has-a relationship",
            "whole part relationship",
            "part of relationship"
          ]
        },
        {
          "id": "contains_object",
          "label": "Says one class contains another object",
          "marks": 2,
          "required": true,
          "variants": [
            "contains another object",
            "contains an object",
            "has an object",
            "object as a member",
            "object as member",
            "member variable",
            "instance variable",
            "field of another class",
            "class has another class",
            "class contains another class",
            "one class contains",
            "inside another class",
            "data member"
